# Chiave API di Anthropic (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Auth Token del tuo account Twilio (Console Twilio → Account Info).
# Serve a verificare che le chiamate arrivino davvero da Twilio.
TWILIO_AUTH_TOKEN=

# Indirizzo pubblico HTTPS del server (es. https://centralino.miodominio.it o l'URL di ngrok)
PUBLIC_URL=

PORT=3000
LANGUAGE=it-IT

# Opzionali: modello e "effort" (low = più veloce al telefono)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# Opzionali: voce della sintesi vocale (vedi la documentazione di ConversationRelay)
# TTS_PROVIDER=ElevenLabs
# TTS_VOICE=

# Opzionale: webhook a cui inviare i messaggi dei clienti (Slack, Zapier, Make, n8n...)
# MESSAGE_WEBHOOK_URL=
